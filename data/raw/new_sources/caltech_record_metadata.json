ontactperson", "title": {"en": "Contact person"}}, "affiliations": [{"id": "05dxps055", "name": "California Institute of Technology", "identifiers": [{"identifier": "05dxps055", "scheme": "ror"}]}]}], "title": "Experimental Li-Ion Conductivity and Crystal Structure Database and Predictions", "publisher": "CaltechDATA", "publication_date": "2025-04-25", "dates": [{"date": "2023-11-02", "type": {"id": "created", "title": {"de": "Erstellt", "en": "Created"}}}, {"date": "2025-05-06", "type": {"id": "updated", "title": {"de": "Aktualisiert", "en": "Updated"}}, "description": "Added icsd_and_materialsproject_Li_ionic_conductivity_predictions.csv"}], "related_identifiers": [{"identifier": "10.26434/chemrxiv-2024-712r9", "scheme": "doi", "relation_type": {"id": "isrequiredby", "title": {"de": "Wird gefordert von", "en": "Is required by"}}, "resource_type": {"id": "dataset", "title": {"en": "Dataset"}}}, {"identifier": "10.1039/D5DD00052A", "scheme": "doi", "relation_type": {"id": "isrequiredby", "title": {"de": "Wird gefordert von", "en": "Is required by"}}, "resource_type": {"id": "dataset", "title": {"en": "Dataset"}}}], "rights": [{"id": "cc0-1.0", "title": {"en": "Creative Commons Zero v1.0 Universal"}, "description": {"en": "CC0 waives copyright interest in a work you've created and dedicates it to the world-wide public domain. Use CC0 to opt out of copyright entirely and ensure your work has the widest reach."}, "icon": "cc-cc0-icon", "props": {"url": "https://creativecommons.org/publicdomain/zero/1.0/legalcode", "scheme": "spdx"}}], "description": "<p>This dataset contains experimentally measured lithium ionic conductivities and corresponding crystal structure identifiers for 571 Li-containing compounds. Each entry includes the reported room-temperature ionic conductivity (in S/cm), the ICSD collection code of the associated crystal structure, the DOI for the article in which the conductivity was reported, and the lowest temperature at which the conductivity was measured. The data has been curated from peer-reviewed literature and public databases, and was used to train and validate models in the manuscript <i>\"Classification of (Dis)ordered Structures as Superionic Lithium Conductors with an Experimental Structure-Conductivity Database\"</i> .</p><p>An additional CSV file provides predicted superionic likelihood (PSI) from the ensemble of AtomSets models for all Li-containing compounds in the ICSD and Materials Project, as described in the manuscript.</p><p><i>ChemRxiv</i> DOI: <a href=\"https://doi.org/10.26434/chemrxiv-2024-712r9\">10.26434/chemrxiv-2024-712r9</a><br><i>Digital Discovery</i> DOI: <a href=\"https://doi.org/10.1039/D5DD00052A\">10.1039/D5DD00052A</a></p>", "funding": [{"funder": {"id": "05avmtm72", "name": "Arnold and Mabel Beckman Foundation"}, "award": {"number": "Beckman Young Investigator Award", "title": {"en": "Beckman Young Investigator Award"}}}, {"funder": {"id": "032atxq54", "name": "David and Lucile Packard Foundation"}, "award": {"number": "Packard Fellowship for Science and Engineering", "title": {"en": "Packard Fellowship for Science and Engineering"}}}, {"funder": {"id": "052csg198", "name": "Alfred P. Sloan Foundation"}, "award": {"number": "Sloan Research Fellowship", "title": {"en": "Sloan Research Fellowship"}}}, {"funder": {"id": "019p8h045", "name": "Camille and Henry Dreyfus Foundation"}, "award": {"number": "Camille Dreyfus Teacher-Scholar Award", "title": {"en": "Camille Dreyfus Teacher-Scholar Award"}}}]}, "custom_fields": {}, "access": {"record": "public", "files": "public", "embargo": {"active": false, "until": "2025-05-30", "reason": null}, "status": "open"}, "files": {"enabled": true, "order": [], "count": 2, "total_bytes": 3782912, "entries": {"ionic_conductivity_database.csv": {"id": "03ebe7f4-c80e-4b6c-a1ec-18924d6e339b", "checksum": "md5:d1fcf7c9a7694c8f466932721b76b168", "ext": "csv", "size": 36122, "mimetype": "text/csv", "storage_class": "L", "key": "ionic_conductivity_data